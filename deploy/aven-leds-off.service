[Unit]
# Turn off the board's onboard LEDs (power, heartbeat, eMMC/SD activity).
# Sysfs LED state resets every boot, so this reapplies it. Clearing each
# LED's trigger first is required — otherwise default-on/heartbeat/mmc0
# would just relight them after we zero brightness.
Description=Turn off onboard LEDs
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for led in /sys/class/leds/*; do echo none > "$led/trigger" 2>/dev/null; echo 0 > "$led/brightness" 2>/dev/null; done; true'

[Install]
WantedBy=multi-user.target
